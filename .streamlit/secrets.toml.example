api_key = "replace-with-the-same-value-as-API_KEY"

[auth]
redirect_uri = "http://localhost:8501/oauth2callback"
cookie_secret = "replace-with-a-random-secret-at-least-32-bytes"
expose_tokens = ["access"]

[auth.keycloak]
client_id = "hybrid-rag-dashboard"
client_secret = "set-after-creating-the-client-in-keycloak"
server_metadata_url = "http://localhost:8080/realms/hybrid-rag/.well-known/openid-configuration"
