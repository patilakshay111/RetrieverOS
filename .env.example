APP_ENV=development
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
API_KEY=
OIDC_ISSUER_URL=
OIDC_JWKS_URL=
OIDC_AUDIENCE=hybrid-rag-api
DATABASE_URL=postgresql+psycopg://hybrid_rag:local-postgres-password-change-me@postgres:5432/hybrid_rag
QDRANT_URL=
QDRANT_VECTOR_SIZE=1536
USER_KEY_ENCRYPTION_KEY=generate-with-scripts-init-local-env
DATA_DIR=./data/runtime
CHUNK_SIZE=900
CHUNK_OVERLAP=150
SEMANTIC_SIMILARITY_THRESHOLD=0.72
DEDUPLICATION_THRESHOLD=0.95
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RRF_K=60
DENSE_TOP_K=10
SPARSE_TOP_K=10
RERANK_TOP_K=20
FINAL_TOP_K=5
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MIN_RETRIEVAL_CONFIDENCE=0.4
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:5173,http://localhost:8501
WEB_BASE_URL=http://localhost:5173
INVITATION_EXPIRY_HOURS=72
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=false
SMTP_FROM=Hybrid RAG <no-reply@hybrid-rag.local>
STREAMLIT_API_URL=http://localhost:8000
STREAMLIT_API_KEY=
STREAMLIT_OIDC_ENABLED=false
STREAMLIT_USER_KEYS_ENABLED=true

# Local-only service credentials. Replace these before using a non-local environment.
POSTGRES_DB=hybrid_rag
POSTGRES_USER=hybrid_rag
POSTGRES_PASSWORD=local-postgres-password-change-me
REDIS_PASSWORD=local-redis-password-change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-password-change-me
