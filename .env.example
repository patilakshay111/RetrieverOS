APP_ENV=development
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
API_KEY=
OIDC_ISSUER_URL=http://localhost:8080/realms/retrieveros
OIDC_JWKS_URL=http://keycloak:8080/realms/retrieveros/protocol/openid-connect/certs
OIDC_AUDIENCE=retrieveros-api
DATABASE_URL=postgresql+psycopg://retrieveros:local-postgres-password-change-me@postgres:5432/retrieveros
QDRANT_URL=
QDRANT_VECTOR_SIZE=1536
REDIS_URL=
REDIS_CACHE_TTL_SECONDS=60
REDIS_CACHE_MAX_VALUE_BYTES=262144
REDIS_RATE_LIMIT_REQUESTS=120
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
USER_KEY_ENCRYPTION_KEY=generate-with-scripts-init-local-env
DATA_DIR=./data/runtime
CHUNK_SIZE=900
CHUNK_OVERLAP=150
SEMANTIC_SIMILARITY_THRESHOLD=0.72
DEDUPLICATION_THRESHOLD=0.95
DENSE_WEIGHT=0.7
SPARSE_WEIGHT=0.3
RRF_K=60
DENSE_TOP_K=10
SPARSE_TOP_K=10
RERANK_TOP_K=20
FINAL_TOP_K=5
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
MIN_RETRIEVAL_CONFIDENCE=0.4
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM=retrieveros
KEYCLOAK_WEB_CLIENT_ID=retrieveros-web
INVITATION_EXPIRY_HOURS=72
# Outgoing mail (workspace invitations). Explicit SMTP_HOST/SMTP_PORT/etc. win.
# Otherwise: if GOOGLE_OAUTH_CLIENT_ID/SECRET are set, mail is sent via Gmail;
# otherwise it is delivered to the local Mailpit catcher (http://localhost:8025).
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=false
SMTP_FROM=RetrieverOS <no-reply@retrieveros.local>
# Local-only service credentials. Replace these before using a non-local environment.
POSTGRES_DB=retrieveros
POSTGRES_USER=retrieveros
POSTGRES_PASSWORD=local-postgres-password-change-me
REDIS_PASSWORD=local-redis-password-change-me
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-password-change-me
GOOGLE_OAUTH_CLIENT_ID=your-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret

# Developer admin account (used to test the platform after a fresh start).
# The configure_keycloak.py script creates this user in Keycloak with the
# platform-admin realm role so it can sign in with email + password.
DEV_ADMIN_EMAIL=dev@retrieveros.local
DEV_ADMIN_USERNAME=dev.admin
DEV_ADMIN_PASSWORD=DevAdmin123!